# Copia este archivo como .env.local y completa tu clave.
# Sin clave, el asistente funciona en "modo demostración": muestra los
# fragmentos del curso que mejor responden la pregunta, sin redactar con IA.

# Clave de la API de Anthropic (se crea en https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Opcional: modelo de Claude. Por defecto: claude-opus-5-5 (Claude Opus 5.5)
# ANTHROPIC_MODEL=claude-opus-5-5

# Opcional: esfuerzo de razonamiento (low | medium | high). Por defecto: low,
# que responde más rápido y es suficiente para dudas de un curso.
# ANTHROPIC_EFFORT=low

# Opcional: carpeta donde se guardan las publicaciones, preguntas y pagos
# simulados. Por defecto: .data (en Vercel se usa /tmp y se borra seguido).
# DATA_DIR=.data

# --- Gemini (Google) ------------------------------------------------------
# Alternativa gratuita (con límites diarios) a Claude. La clave se crea sin
# tarjeta en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opcional: modelo de Gemini. Por defecto: gemini-flash-latest
# GEMINI_MODEL=gemini-flash-latest

# Opcional: qué IA usar si tienes las dos claves (claude | gemini | demo).
# Si no lo defines, se usa Claude cuando tiene clave y, si no, Gemini.
# IA_PROVEEDOR=gemini

# --- Cuentas ---------------------------------------------------------------
# Entrar con Google: credenciales OAuth de Google Cloud ("Aplicación web").
# Dirección de regreso autorizada: <tu sitio>/api/auth/google/callback
# Sin ellas, la entrada con Google no aparece.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Opcional: contraseña de las cuentas de demostración (por defecto la del
# proyecto, que se muestra en la pantalla de entrada). Con CUENTAS_DEMO=0
# las cuentas de demostración no pueden entrar.
# CONTRASENA_DEMO=
# CUENTAS_DEMO=0
